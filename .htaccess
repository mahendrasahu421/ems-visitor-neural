<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block access to sensitive files and system directories
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package\.(json|lock)|artisan) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests)/ - [F,L,NC]

    # 2. Preserve Authorization Header for APIs (Sanctum / Bearer Tokens)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 3. Canonical 301 Redirect: Remove "/public/" from external URLs if present
    # e.g., https://neuralinfo.in/ems/public/employee/login -> https://neuralinfo.in/ems/employee/login
    RewriteCond %{THE_REQUEST} /public/([^\s?]*) [NC]
    RewriteRule ^ %1 [L,NE,R=301]

    # 4. Internally route all clean requests to the public/ directory
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Extra security for FastCGI / PHP-FPM Authorization Header
<IfModule mod_setenvif.c>
    SetEnvIfNoCase ^Authorization$ "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>
